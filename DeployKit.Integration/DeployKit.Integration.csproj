<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>

    <IsPackable>true</IsPackable>
    <PackageId>DeployKit.Integration</PackageId>
    <Version>1.1.0</Version>
    <Title>DeployKit Integration SDK</Title>
    <Description>One-line auto-update SDK for .NET WPF desktop apps. Detects version, checks cloud for updates, shows update UI, and applies via updater.exe. Full-package updates with smart file-level delta extraction.</Description>
    <Authors>DeployKit</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/dahakabdellah12/DeployKit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dahakabdellah12/DeployKit</RepositoryUrl>
    <PackageTags>update;deploy;auto-update;deploykit;wpf</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Build Core dependency -->
  <Target Name="_BuildCore" BeforeTargets="Build">
    <MSBuild Projects="..\DeployKit.Core\DeployKit.Core.csproj" Targets="Build" Properties="Configuration=$(Configuration)" />
  </Target>

  <!-- Include README -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Include README -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Project reference to Core (for compilation only, not a NuGet dependency) -->
  <ItemGroup>
    <ProjectReference Include="..\DeployKit.Core\DeployKit.Core.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

</Project>
